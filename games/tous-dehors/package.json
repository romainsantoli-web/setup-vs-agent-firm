{
  "name": "tous-dehors",
  "version": "0.2.0",
  "private": true,
  "description": "Puzzle de flèches mobile : JavaScript, WebGL et Canvas, sans dépendance.",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=src/core/** --test-coverage-include=src/game/** --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 \"tests/*.test.mjs\"",
    "serve": "python3 -m http.server 8080"
  },
  "engines": {
    "node": ">=22"
  }
}
